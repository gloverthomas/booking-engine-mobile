{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.hairmate.world",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "995433425648-1k0qflaghamq48hs5qeu88qlkhp1d5dp.apps.googleusercontent.com",
        "EXPO_PUBLIC_DEV_SIGN_IN": "1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SIMULATED_READER": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.hairmate.world",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "995433425648-1k0qflaghamq48hs5qeu88qlkhp1d5dp.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.hairmate.world",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "995433425648-1k0qflaghamq48hs5qeu88qlkhp1d5dp.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
