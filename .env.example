# Copy to .env.local. EXPO_PUBLIC_* values are baked into the app bundle: nothing secret belongs here.

# The booking-engine web service the app talks to (no trailing slash).
EXPO_PUBLIC_API_URL=https://app.hairmate.world

# Google Cloud > Credentials > OAuth client of type iOS (bundle id world.hairmate.app).
# The server must list the same id in GOOGLE_IOS_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional: when set, Google issues ID tokens for the web client instead. The server accepts either.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Development builds only: shows a "paste a session token" box on the sign-in screen.
# EXPO_PUBLIC_DEV_SIGN_IN=1
